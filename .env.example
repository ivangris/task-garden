# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
# Only set this for a private hosted frontend that talks to hosted mode.
VITE_API_AUTH_TOKEN=

# Backend
TASK_GARDEN_ENV=development
TASK_GARDEN_APP_NAME=Task Garden API
TASK_GARDEN_API_HOST=127.0.0.1
TASK_GARDEN_API_PORT=8000
TASK_GARDEN_DATABASE_URL=sqlite:///../../data/sqlite/task-garden.db
TASK_GARDEN_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TASK_GARDEN_HOSTED_MODE=false
TASK_GARDEN_SINGLE_USER_AUTH_TOKEN=
TASK_GARDEN_LOGGING_LEVEL=INFO
TASK_GARDEN_LOCAL_ONLY_MODE=true
TASK_GARDEN_CLOUD_ENABLED=false

# Local providers
TASK_GARDEN_STT_PROVIDER=whisper_cpp
TASK_GARDEN_TASK_EXTRACTION_PROVIDER=mock
TASK_GARDEN_RECAP_NARRATIVE_PROVIDER=off
TASK_GARDEN_SYNC_PROVIDER=local_only
TASK_GARDEN_AUTH_PROVIDER=none

# Use locally installed models. For Ollama, gemma3:4b is a good small default if installed.
TASK_GARDEN_STT_MODEL=ggml-base.en.bin
TASK_GARDEN_EXTRACTION_MODEL=gemma3:4b
TASK_GARDEN_RECAP_MODEL=gemma3:4b
TASK_GARDEN_OLLAMA_BASE_URL=http://127.0.0.1:11434
TASK_GARDEN_EXTRACTION_TIMEOUT_SECONDS=60
TASK_GARDEN_AUDIO_STORAGE_DIR=../../data/audio
TASK_GARDEN_STT_EXECUTABLE_PATH=
TASK_GARDEN_STT_MODEL_PATH=

# Future hosted sync / cloud provider placeholders. Leave empty for local-only development.
TASK_GARDEN_SYNC_BASE_URL=
TASK_GARDEN_CLOUD_API_KEY=

# Private hosted API example values. Do not commit real secrets.
# TASK_GARDEN_ENV=production
# TASK_GARDEN_HOSTED_MODE=true
# TASK_GARDEN_LOCAL_ONLY_MODE=false
# TASK_GARDEN_DATABASE_URL=postgresql+psycopg://task_garden:REPLACE_ME@db.example.com:5432/task_garden
# TASK_GARDEN_CORS_ALLOWED_ORIGINS=https://task-garden.example.com
# TASK_GARDEN_AUTH_PROVIDER=bearer_token
# TASK_GARDEN_SINGLE_USER_AUTH_TOKEN=replace-with-a-long-random-token
# TASK_GARDEN_SYNC_PROVIDER=remote_api
