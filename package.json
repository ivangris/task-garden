{
  "name": "task-garden",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @task-garden/web",
    "dev:web:host": "npm run dev --workspace @task-garden/web -- --host 127.0.0.1 --port 5173",
    "build:web": "npm run build --workspace @task-garden/web",
    "typecheck:web": "npm run typecheck --workspace @task-garden/web",
    "check:garden-assets": "npm run check:garden-assets --workspace @task-garden/web",
    "qa:e2e": "npm run test:e2e --workspace @task-garden/web",
    "qa:e2e:headed": "npm run test:e2e:headed --workspace @task-garden/web",
    "seed:demo": "cd apps/api && .\\.venv\\Scripts\\python.exe scripts\\seed_demo_data.py",
    "verify:data-safety": "apps\\api\\.venv\\Scripts\\python.exe -m unittest discover -s apps\\api\\tests -p test_data_safety.py",
    "verify:baseline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-baseline.ps1"
  }
}
